{
  "format": "openflex-model",
  "version": 1,
  "name": "agv-astar",
  "time_unit": "seconds",
  "description": "An AGV plans on its directed network: the depot-to-processor route is 30 units instead of the 10-unit straight line",
  "run": {"stop_time": 300.0, "warmup": 0.0, "seed": 1, "replications": 1},
  "objects": [
    {"name": "Source1", "kind": "source", "pos": [10, 0], "params": {
      "interarrival": {"distribution": "constant", "value": 20.0}, "first_arrival": 0.0}},
    {"name": "Processor1", "kind": "processor", "pos": [10, 0], "params": {
      "process_time": {"distribution": "constant", "value": 4.0},
      "process_operator": "Dispatcher1"}},
    {"name": "Sink1", "kind": "sink", "params": {}},
    {"name": "Dispatcher1", "kind": "dispatcher", "pos": [0, 0], "params": {}},
    {"name": "Agv1", "kind": "agv", "pos": [0, 0], "params": {
      "capacity": 1, "speed": 2.0, "home": "Dispatcher1",
      "network": [
        {"from": "Dispatcher1", "to": "Processor1", "distance": 30.0, "directed": true}
      ]}}
  ],
  "connections": [
    {"from": "Source1", "to": "Processor1"},
    {"from": "Processor1", "to": "Sink1"},
    {"from": "Dispatcher1", "to": "Agv1"}
  ]
}
