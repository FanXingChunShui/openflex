{
  "format": "openflex-model",
  "version": 1,
  "name": "scenario-stop-warmup",
  "description": "Experiment scenarios with their own stop time and warm-up (A13); the CLI experiment report shows both per scenario",
  "time_unit": "minutes",
  "run": { "stop_time": 1000.0, "warmup": 0.0, "seed": 7, "replications": 2 },
  "objects": [
    { "name": "Arrivals", "kind": "source", "pos": [0, 0], "params": {
        "interarrival": { "distribution": "exponential", "mean": 5.0 },
        "max_arrivals": 200 } },
    { "name": "Queue1", "kind": "queue", "pos": [10, 0], "params": {
        "max_content": 1000 } },
    { "name": "Proc1", "kind": "processor", "pos": [20, 0], "params": {
        "process_time": { "distribution": "exponential", "mean": 4.0 } } },
    { "name": "Sink1", "kind": "sink", "pos": [30, 0], "params": {} }
  ],
  "connections": [
    { "from": "Arrivals", "to": "Queue1" },
    { "from": "Queue1", "to": "Proc1" },
    { "from": "Proc1", "to": "Sink1" }
  ],
  "experiments": [
    {
      "name": "stop-warmup",
      "replications": 2,
      "scenarios": [
        { "name": "baseline", "warmup": 100.0, "stop_time": 500.0 },
        { "name": "short", "warmup": 50.0, "stop_time": 200.0 }
      ]
    }
  ]
}
