{
  "format": "openflex-model",
  "version": 1,
  "name": "fluid-pipe",
  "description": "Fluid pipe (B5): tank -> 10-unit pipe at speed 2 (5s delay) -> valve with 5/s pressure threshold -> sink",
  "time_unit": "seconds",
  "run": { "stop_time": 60.0, "warmup": 0.0, "seed": 1, "replications": 1 },
  "fluid_step": 0.1,
  "objects": [
    { "name": "Generator1", "kind": "fluid_generator", "params": { "flow_rate": 10.0 } },
    { "name": "Tank1", "kind": "fluid_tank", "params": {
        "capacity": 100.0, "initial_level": 0.0, "max_outflow": 10.0 } },
    { "name": "Pipe1", "kind": "fluid_pipe", "params": {
        "length": 10.0, "speed": 2.0, "flow_rate": 10.0 } },
    { "name": "Valve1", "kind": "fluid_valve", "params": {
        "ratio": 1.0, "pressure_threshold": 5.0 } },
    { "name": "Sink1", "kind": "fluid_sink", "params": {} }
  ],
  "connections": [
    { "from": "Generator1", "to": "Tank1" },
    { "from": "Tank1", "to": "Pipe1" },
    { "from": "Pipe1", "to": "Valve1" },
    { "from": "Valve1", "to": "Sink1" }
  ]
}
