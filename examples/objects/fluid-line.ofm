{
  "format": "openflex-model",
  "version": 1,
  "name": "fluid-line",
  "description": "Fluid line (B5): generator 10/s -> tank(100) -> valve 0.5 -> sink, fixed step 0.1",
  "time_unit": "seconds",
  "run": { "stop_time": 60.0, "warmup": 0.0, "seed": 1, "replications": 1 },
  "fluid_step": 0.1,
  "objects": [
    { "name": "Generator1", "kind": "fluid_generator", "pos": [0, 0], "params": {
        "flow_rate": 10.0 } },
    { "name": "Tank1", "kind": "fluid_tank", "pos": [5, 0], "params": {
        "capacity": 100.0, "initial_level": 0.0, "max_outflow": 5.0 } },
    { "name": "Valve1", "kind": "fluid_valve", "pos": [10, 0], "params": {
        "open": true, "ratio": 0.5 } },
    { "name": "Sink1", "kind": "fluid_sink", "pos": [15, 0], "params": {} }
  ],
  "connections": [
    { "from": "Generator1", "to": "Tank1" },
    { "from": "Tank1", "to": "Valve1" },
    { "from": "Valve1", "to": "Sink1" }
  ]
}
