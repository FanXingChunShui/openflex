{
  "format": "openflex-model",
  "version": 1,
  "name": "elevator",
  "description": "Elevator (B6): 5 operators carried from floor 0 to a processor on floor z=3, 1s door dwell",
  "time_unit": "seconds",
  "run": { "stop_time": 100.0, "warmup": 0.0, "seed": 1, "replications": 1 },
  "objects": [
    { "name": "Source1", "kind": "source", "pos": [0, 0], "params": {
        "interarrival": { "distribution": "constant", "value": 20.0 },
        "max_arrivals": 5, "first_arrival": 0.0 } },
    { "name": "Processor1", "kind": "processor", "pos": [0, 0], "z": 3.0, "params": {
        "process_time": { "distribution": "constant", "value": 2.0 },
        "process_operator": "Dispatcher1" } },
    { "name": "Sink1", "kind": "sink", "pos": [5, 0], "params": {} },
    { "name": "Dispatcher1", "kind": "dispatcher", "pos": [0, 0], "z": 0.0, "params": {} },
    { "name": "Elevator1", "kind": "elevator", "pos": [0, 0], "z": 0.0, "params": {
        "capacity": 1, "speed": 1.0,
        "stop_time": { "distribution": "constant", "value": 1.0 },
        "home": "Dispatcher1" } }
  ],
  "connections": [
    { "from": "Source1", "to": "Processor1" },
    { "from": "Processor1", "to": "Sink1" },
    { "from": "Dispatcher1", "to": "Elevator1" }
  ]
}
