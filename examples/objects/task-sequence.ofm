{
  "format": "openflex-model",
  "version": 1,
  "name": "task-sequence",
  "time_unit": "seconds",
  "description": "Dispatcher task sequence with an extra travel leg: every operator task costs one additional round trip",
  "run": {"stop_time": 400.0, "warmup": 0.0, "seed": 1, "replications": 1},
  "objects": [
    {"name": "Source1", "kind": "source", "pos": [0, 0], "params": {
      "interarrival": {"distribution": "constant", "value": 10.0}, "first_arrival": 0.0}},
    {"name": "Processor1", "kind": "processor", "pos": [0, 0], "params": {
      "process_time": {"distribution": "constant", "value": 4.0},
      "process_operator": "Dispatcher1"}},
    {"name": "Sink1", "kind": "sink", "pos": [0, 0], "params": {}},
    {"name": "Dispatcher1", "kind": "dispatcher", "pos": [100, 0], "params": {
      "task_sequence": ["travel", "travel", "travel", "load", "unload"]}},
    {"name": "Transporter1", "kind": "transporter", "pos": [100, 0], "params": {
      "capacity": 1, "speed": 1.0, "home": "Dispatcher1"}}
  ],
  "connections": [
    {"from": "Source1", "to": "Processor1"},
    {"from": "Processor1", "to": "Sink1"},
    {"from": "Dispatcher1", "to": "Transporter1"}
  ]
}
