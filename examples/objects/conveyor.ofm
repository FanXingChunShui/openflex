{
  "format": "openflex-model",
  "version": 1,
  "name": "conveyor-demo",
  "description": "Source → Conveyor(10 m at 2 m/s) → Sink: items spend 5 time units on the belt",
  "time_unit": "seconds",
  "run": { "stop_time": 300.0, "warmup": 0.0, "seed": 1, "replications": 1 },
  "objects": [
    { "name": "Source1", "kind": "source", "pos": [0, 0], "params": {
        "interarrival": { "distribution": "constant", "value": 10.0 }, "first_arrival": 0.0 } },
    { "name": "Conveyor1", "kind": "conveyor", "pos": [5, 0], "params": {
        "speed": 2.0, "length": 10.0, "item_spacing": 1.0,
        "accumulating": true, "max_content": 100 } },
    { "name": "Sink1", "kind": "sink", "pos": [15, 0], "params": {} }
  ],
  "connections": [
    { "from": "Source1", "to": "Conveyor1" },
    { "from": "Conveyor1", "to": "Sink1" }
  ]
}
