{
  "format": "openflex-model",
  "version": 1,
  "name": "shifts-demo",
  "description": "Two 240s shifts per 480s day: the processor pauses off shift",
  "time_unit": "seconds",
  "run": { "stop_time": 600.0, "warmup": 0.0, "seed": 1, "replications": 1 },
  "objects": [
    { "name": "Source1", "kind": "source", "pos": [0, 0], "params": {
        "interarrival": { "distribution": "constant", "value": 10.0 }, "first_arrival": 0.0 } },
    { "name": "Processor1", "kind": "processor", "pos": [10, 0], "params": {
        "process_time": { "distribution": "constant", "value": 4.0 },
        "shifts": [{ "start": 0.0, "duration": 240.0, "repeat_every": 480.0 }] } },
    { "name": "Sink1", "kind": "sink", "pos": [20, 0], "params": {} }
  ],
  "connections": [
    { "from": "Source1", "to": "Processor1" },
    { "from": "Processor1", "to": "Sink1" }
  ]
}
