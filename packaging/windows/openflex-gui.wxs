<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX template for the OpenFlex desktop GUI installer (WiX Toolset v4/v5 syntax).

  Build (from the repository root, on Windows):
    cargo build -p openflex-gui -r
    wix build packaging\windows\openflex-gui.wxs ^
        -d Version=0.1.0 ^
        -d BinaryPath=target\release\openflex-gui.exe ^
        -d LicensePath=LICENSE ^
        -arch x64 ^
        -o dist\openflex-gui-0.1.0-windows-x64.msi

  Scope="perUser" installs into %LOCALAPPDATA%\OpenFlex GUI\bin and adds a
  Start-menu shortcut, so no administrator rights are needed.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="OpenFlex GUI"
      Manufacturer="OpenFlex contributors"
      Version="$(var.Version)"
      UpgradeCode="B7D4E1A2-8C6F-4D3B-9A5E-2F1C7B8D4E60"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenFlex GUI is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="OpenFlexGuiRoot" Name="OpenFlex GUI">
        <Directory Id="OpenFlexGuiBin" Name="bin" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="OpenFlexGuiMenu" Name="OpenFlex GUI" />
    </StandardDirectory>

    <ComponentGroup Id="OpenFlexGuiComponents" Directory="OpenFlexGuiBin">
      <Component Id="OpenFlexGuiExe" Guid="C8E5F2B3-9D70-4E4C-8B6F-3A2D1C9E5F71">
        <File Id="OpenFlexGuiExeFile"
              Source="$(var.BinaryPath)"
              KeyPath="yes" />
        <Environment Id="OpenFlexGuiPathEnv"
                     Name="PATH"
                     Value="[OpenFlexGuiBin]"
                     Action="set"
                     Part="last"
                     Permanent="no"
                     System="no" />
        <Shortcut Id="OpenFlexGuiStartMenu"
                  Directory="OpenFlexGuiMenu"
                  Name="OpenFlex GUI"
                  Description="OpenFlex desktop simulation editor"
                  Target="[OpenFlexGuiBin]openflex-gui.exe"
                  WorkingDirectory="OpenFlexGuiBin" />
        <Shortcut Id="OpenFlexGuiDesktop"
                  Directory="DesktopFolder"
                  Name="OpenFlex GUI"
                  Description="OpenFlex desktop simulation editor"
                  Target="[OpenFlexGuiBin]openflex-gui.exe"
                  WorkingDirectory="OpenFlexGuiBin" />
        <RemoveFolder Id="OpenFlexGuiMenuFolder" Directory="OpenFlexGuiMenu" On="uninstall" />
      </Component>
    </ComponentGroup>

    <Feature Id="OpenFlexGuiFeature" Title="OpenFlex GUI" Level="1">
      <ComponentGroupRef Id="OpenFlexGuiComponents" />
    </Feature>
  </Package>
</Wix>
